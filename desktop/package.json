{
  "name": "roam-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for ROAM",
  "main": "build/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "pack:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
