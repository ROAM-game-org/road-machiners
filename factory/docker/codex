#!/bin/bash
# Runs the real Codex without its own sandbox. Its sandbox needs Linux namespaces, which Docker denies, so every shell command it tried would fail.
# The agent container is the sandbox. Any -s or --sandbox flag a game doc passes is dropped.
set -euo pipefail

args=()
skip=0
for arg in "$@"; do
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case "$arg" in
    -s|--sandbox) skip=1 ;;
    --sandbox=*) ;;
    *) args+=("$arg") ;;
  esac
done

exec /usr/lib/node_modules/@openai/codex/bin/codex.js --dangerously-bypass-approvals-and-sandbox "${args[@]}"
