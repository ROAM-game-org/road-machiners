// Branches. Each arrow is a merge.
digraph branches {
  rankdir=LR; nodesep=0.35; ranksep=0.8; bgcolor=white; pad=0.3;
  node [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=13, margin="0.2,0.1", penwidth=1.3, width=1.4];
  edge [color="#374151", penwidth=1.6, arrowsize=0.8, fontname="Helvetica", fontsize=11];
  issue [label="factory/issue-N"]; dev [label="dev", fillcolor="#c7d2fe"]; cand [label="factory/candidate\nthe passed dev commit", fillcolor="#c7d2fe"]; main [label="main", fillcolor="#c7d2fe"];
  hotfix [label="factory/issue-N\nhotfix, from main"];
  issue -> dev [label="merge queue"]; dev -> cand [label="playtest pass"]; cand -> main [label="ship"];
  hotfix -> main [label="hotfix approve"];
  edge [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.3];
  main -> dev [label="after ship or hotfix", constraint=false];
  dev -> issue [label="before design, testing\nor hardening", constraint=false];
}
