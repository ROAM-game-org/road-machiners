// Public inputs: voting, build feedback, game reports and chat messages. Every chat message has one handler, Hermes. Black: normal path. Red: loops back. Grey: leaves the flow. Yellow: waits for people.
digraph public {
  rankdir=LR; nodesep=0.3; ranksep=0.55; bgcolor=white; pad=0.3; newrank=true;
  node [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=13, margin="0.2,0.1", penwidth=1.3, width=1.5];
  edge [color="#374151", penwidth=1.8, arrowsize=0.8, fontname="Helvetica", fontsize=11];

  subgraph cluster_vote {
    label="1. Voting"; fontname="Helvetica-Bold"; fontsize=14; color="#d1d5db"; style=rounded;
    triage [label="Triage\ngroomed, verdict vote\nlabel voting"];
    proposal [label="Proposal post\nin the player chat\nat most 4 a day"];
    votes [label="Players react 👍 or 👎", fillcolor="#fde68a", color="#b45309"];
    design [label="Design\nat 3 more 👍 than 👎"];
    triage -> proposal -> votes -> design;
  }

  subgraph cluster_build {
    label="2. Build feedback"; fontname="Helvetica-Bold"; fontsize=14; color="#d1d5db"; style=rounded;
    testing [label="Testing\nbuilds the card"];
    committeePost [label="Committee post\nwith Approve and Deny"];
    reply [label="Reply to the proposal\nplay link, no buttons"];
    comment [label="Players play\nand comment", fillcolor="#fde68a", color="#b45309"];
    testing -> committeePost;
    testing -> reply -> comment;
  }

  subgraph cluster_report {
    label="3. Game reports"; fontname="Helvetica-Bold"; fontsize=14; color="#d1d5db"; style=rounded;
    form [label="Player sends a bug\nor an idea in the game", fillcolor="#fde68a", color="#b45309"];
    feedback [label="/feedback\nchecks origin, size\nand 60 an hour per address"];
    form -> feedback;
  }

  subgraph cluster_chat {
    label="4. Chat messages"; fontname="Helvetica-Bold"; fontsize=14; color="#d1d5db"; style=rounded;
    message [label="Player writes in the chat\nkeeps the replied text\nand images", fillcolor="#fde68a", color="#b45309"];
    plugin [label="Plugin\nwrites the inbox file\nmarks whether it\naddressed the bot"];
    hermes [label="Hermes, the one handler\nof every addressed message\nuntrusted text, public prompt\nno committee order"];
    tools [label="Player tools\nfactory player on the host\nonly this player's\nown messages"];
    hermesReply [label="Hermes answers in the thread\nissue numbers and statuses\nonly from tool results"];
    untagged [label="Stored, never to Hermes\nuntagged chat, thread replies\nand replies to other players\nno answer, no card", fillcolor="#f3f4f6", color="#6b7280", fontcolor="#374151"];
    message -> plugin;
    plugin -> hermes [label="a tag of the bot or\na reply to Hermes's answer"];
    hermes -> tools;
    hermes -> hermesReply [label="every message it gets"];
  }

  filter [label="Decisions API filter\nspam, kind, about the build\ngame reports only\nnever a chat message"];
  digest [label="Digest comment\non the issue\nat most one an hour"];
  newIssue [label="Own issue\nbug or feature-request\nand player-report"];
  answerJob [label="Answer job, one at a time\nat most FACTORY_ANSWERS_PER_DAY\nSonnet reads and runs\nthe game on main,\nreplies with its answer"];
  images [label="Its images and the replied\nperson's image, downloaded once\ninto the issue's media folder"];
  intake [label="Intake\nthen Triage"];
  releaseTask [label="Task of the open release\nrelease.tasks, once a tick\nholds playtest, candidate and Ship"];
  patch [label="Card to Testing\nthe comment is the task"];
  redesign [label="Card to Design"];
  rejected [label="Dropped as spam", fillcolor="#f3f4f6", color="#6b7280", fontcolor="#374151"];
  ignored [label="Kept nowhere\nbots, forwards, commands\nmessages with no text", fillcolor="#f3f4f6", color="#6b7280", fontcolor="#374151"];

  design -> testing [weight=0];
  comment -> plugin;
  feedback -> filter;
  filter -> digest [label="a report about the change\nof a card's build, or\nfeedback on the candidate"];
  filter -> newIssue [label="game report: bug or feature\noff the build's change, any other\nreport, or a bug, feature, patch\nor redesign on the candidate"];
  tools -> newIssue [label="file_issue\nbug, or idea asked to file"];
  tools -> digest [label="add_to_issue\ntagged thread feedback\nor open known work"];
  tools -> answerJob [label="queue_answer_job"];
  newIssue -> intake;
  newIssue -> releaseTask [label="from the candidate"];
  digest -> images;
  newIssue -> images;

  edge [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.3];
  filter -> patch [label="game report: patch"];
  filter -> redesign [label="game report: redesign"];
  tools -> patch [label="route_build: patch"];
  tools -> redesign [label="route_build: redesign"];
  proposal -> proposal [label="closed unposted\nwhile its issue is open:\nopened again"];

  edge [color="#6b7280", fontcolor="#6b7280", style=dashed, penwidth=1.3];
  filter -> rejected [label="spam"];
  plugin -> ignored;
  plugin -> untagged;
}
