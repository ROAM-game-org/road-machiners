[Unit]
Description=Check that every ROAM game factory service works after a boot
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ script }} {{ factory_root }} {{ service_user }} {{ check_minutes }} {{ public_url }}
StandardOutput=append:{{ home_dir }}/logs/boot-check.log
StandardError=append:{{ home_dir }}/logs/boot-check.log
TimeoutStartSec={{ check_minutes + 5 }}min

[Install]
WantedBy=multi-user.target
