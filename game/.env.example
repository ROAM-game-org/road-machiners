# Sound generation for scripts/sfx-gen.mjs only; never sent to the browser. Paid plans allow commercial use.
ELEVENLABS_API_KEY=
# Most ElevenLabs generations one sfx:gen run may make.
SFX_MAX_GENERATIONS=6
# itch.io page for npm run itch, as "user/game".
ITCH_TARGET=
# itch.io API key for butler, from https://itch.io/user/settings/api-keys.
BUTLER_API_KEY=
# SSH target of the Windows bench machine for npm run perf:remote, as "user@host".
PERF_HOST=
# Static server rooted at the repo root, for tools/hud-bake, as "http://127.0.0.1:8731".
HUD_BAKE_SERVER_URL=
# Running game dev server that tools/hud-bake captures the live HUD from, as "http://localhost:5173".
HUD_BAKE_GAME_URL=
