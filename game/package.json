    "quest": "vite-node scripts/quest.mjs",
    "quest:playtest": "node scripts/quest-playtest.mjs",
    "quest:view": "node scripts/quest-view.mjs",
    "economy:shock": "vite-node scripts/economy-shock.mjs"
