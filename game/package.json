    "income": "ROAM_NO_WATCH=1 vite-node scripts/income.mjs",
    "progression:record": "vite-node scripts/progression-record.mjs",
    "progression:playthrough": "vite-node scripts/progression-playthrough.mjs",
    "progression:report": "vite-node scripts/progression-report.mjs",
