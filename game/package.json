    "perf": "node scripts/perf.mjs",
    "site:shot": "node scripts/site-shot.mjs",
    "shot": "node scripts/shot.mjs",
    "sfx:gen": "vite-node scripts/sfx-gen.mjs",
    "sfx:import": "vite-node scripts/sfx-import.mjs",
    "sfx:board": "vite --open /sound.html",
