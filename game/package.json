    "quest-art:crops": "uv run --quiet --with pillow python -I tools/quest-art/crops.py",
    "models:bake": "vite-node scripts/models-bake.mjs",
    "models:shapes": "node scripts/prop-shapes.mjs && node scripts/truck-shapes.mjs",
    "save:shape": "vite-node scripts/save-shape.mjs",
    "old-spots": "vite-node scripts/old-spots.mjs && vite-node scripts/old-spots.mjs",
